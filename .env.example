# Copy this file to `.env` (same directory) and fill in your key.
#
#     cp .env.example .env
#
# `.env` is gitignored. Only the "Ask Claude" and "Generate code" tabs need this
# key -- datasets, charts, model training and prediction all work without it.
#
# Get a key at https://console.anthropic.com/settings/keys
#
# Note: a variable already exported in your shell takes precedence over this
# file, so `$env:ANTHROPIC_API_KEY` will win if both are set.

ANTHROPIC_API_KEY=sk-ant-...

# Optional -- only needed by the download_kaggle_dataset tool.
# KAGGLE_USERNAME=
# KAGGLE_KEY=
